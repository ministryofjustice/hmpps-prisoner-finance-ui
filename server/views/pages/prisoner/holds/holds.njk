{%- extends "partials/layout-full-width.njk" -%}


{%- from "partials/data-warning-banner/macro.njk" import dataWarningBanner -%}
{%- from "partials/holds-list/macro.njk" import holdsList -%}
{%- from "components/balanceCard/balanceCard.njk" import balanceCard -%}
{%- from "moj/components/sub-navigation/macro.njk" import mojSubNavigation -%}

{%- set pageTitle = headerTitle -%}
{%- set backUrl = "/prisoner/" + prisonNumber -%}


{% block contentHeader %}
  {{ dataWarningBanner(dataWarningBannerEnabled) }}
{% endblock %}

{% block innerContent %}

{% set holdsTable %}
    {{ holdsList({
        holds: holds,
        paginationItems: paginationItems,
        prisonNames: prisonNames,
        currentHoldType: currentHoldType
    }) }}
{% endset %}

<ul class="govuk-grid-row card-group">
    <li class="govuk-grid-column-one-quarter card-group__item">
      {{ balanceCard({
        heading: "Holds total",
        subHeading: 'Total',
        amount: holdsBalance.amount,
        headingSize: "s"
      }) }}
    </li>
    <li class="govuk-grid-column-one-quarter card-group__item ">
      {{ balanceCard({
        heading: "Withheld funds (WHF)",
        subHeading: 'Total',
        amount: holdsBalance.whf,
        headingSize: "s"
      }) }}
    </li>
    <li class="govuk-grid-column-one-quarter card-group__item">
      {{ balanceCard({
        heading: "On hold (HOA)",
        subHeading: 'Total',
        amount: holdsBalance.hoa,
        headingSize: "s"
      }) }}
    </li>
</ul>

{{ mojSubNavigation({
  label: 'Holds navigation',
  items: [
    {
      text: 'All holds',
      href: '?',
      active: currentHoldType === undefined
    },
    {
      text: 'Withheld funds (WHF)',
      href: '?holdType=WHF',
      active: currentHoldType === 'WHF'
    },
    {
      text: 'On hold (HOA)',
      href: '?holdType=HOA',
      active: currentHoldType === 'HOA'
    }
  ]
}) }}

{{ holdsTable | safe }}


{% endblock %}
