{%- macro advancePaymentsRemainingCard(params) -%}
  <div class="card {% if params.clickable %} card--clickable{% endif %} hmpps-balance-card">
    <h2 class="govuk-heading-m card__heading hmpps-balance-card__header">{{ params.heading }}</h2>

    <div class="hmpps-balance-card__body">
      <p class="govuk-body card__description hmpps-balance-card__description">Total</p>
      <p class="govuk-body hmpps-balance-card__total" data-testid='remainingPayments'>{{ params.remainingPayments  }}</p>
      <b  data-testid='nextPaymentDate'>Next: {{params.nextPaymentDate | formatDate('d MMM yyyy') }}</b>
    </div>
  </div>
{%- endmacro -%}
