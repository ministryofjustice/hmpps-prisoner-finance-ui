
{% if appInsightsConnectionString %}
    <script type="text/javascript" src="/assets/applicationinsights-web.min.js"></script>
    <script type="text/javascript" src="/assets/applicationinsights-clickanalytics-js.min.js"></script>
    <script type="text/javascript" nonce="{{ cspNonce }}">
      var clickPluginInstance = new Microsoft.ApplicationInsights.ClickAnalyticsPlugin();
      // Click Analytics configuration
      var clickPluginConfig = {
          autoCapture : true,
          dataTags: {
              useDefaultContentNameOrId: true
          }
      }
      var snippet = {
        config: {
          connectionString: "{{ appInsightsConnectionString }}",
          extensions: [
                clickPluginInstance
            ],
          extensionConfig: {
                [clickPluginInstance.identifier] : clickPluginConfig
            },
          autoTrackPageVisitTime: true
        }
      }
      var init = new Microsoft.ApplicationInsights.ApplicationInsights(snippet)
      var appInsights = init.loadAppInsights();
      appInsights.addTelemetryInitializer(function (envelope) {
          envelope.tags["ai.cloud.role"] = "hmpps-prisoner-finance"
          envelope.tags["ai.application.ver"] = "{{ buildNumber }}"

          if (envelope && (envelope.baseType === "EventData" || envelope.baseType === "PageviewData")) {
            envelope.baseData.properties = envelope.baseData.properties || {};
            envelope.baseData.properties.user_uuid = '{{ user.user_uuid | default("") | safe }}';
            envelope.baseData.properties.caseloadId = '{{ user.activeCaseLoad.caseLoadId | default("") | safe }}';
          }
        });
      appInsights.trackPageView()
    </script>
  {% endif %}
