{%- from "moj/components/pagination/macro.njk" import mojPagination -%}
{%- from "govuk/components/table/macro.njk" import govukTable -%}

{% if subscriptions | length > 0 %}
  {% set rows = [] %}
  {% for subscription in subscriptions %}
    {% set rowData = [
      { text: subscription.subscriptionType   },
      { text: subscription.startDate | formatDate("dd/MM/yy")},
      { text: subscription.endDate | formatDate("dd/MM/yy") | default('No data')},
      { text: subscription.reference},
      { text: subscription.amount |penceToPound, format: "numeric"},
      { text: subscription.createdBy}
    ] %}
    {% set rows = (rows.push(rowData), rows) %}
  {% endfor %}

  <div class="subscriptions-list">
    {% set head = [
      { text: "Payment type" },
      { text: "Start date"},
      { text: "End date" },
      { text: "Reference"},
      { text: "Amount per week", format: "numeric"},
      { text: "User" }
    ] %}
    {% if paginationItems %} {{ mojPagination(paginationItems) }} {% endif %}
    {{ govukTable({ classes: "subscriptions-list__subscriptions", caption: "", captionClasses: "govuk-table__caption--m", head: head, rows: rows }) }}
    {% if paginationItems %} {{ mojPagination(paginationItems) }} {% endif %}
  </div>
{% else %}
  <p class="subscriptions-list__empty-message" data-testid="no-subscriptions-message">
    No subscriptions to show
  </p>
{% endif %}
